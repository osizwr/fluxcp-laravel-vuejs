###############################################################################
# Application
###############################################################################

# Shown in the masthead and the page title. Set it to your server's name.
APP_NAME="Control Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Cost factor for the panel's own password hashes. Raise on faster hardware.
BCRYPT_ROUNDS=12

###############################################################################
# Game branding
###############################################################################
#
# What server this panel fronts. Separate from the theme on purpose: renaming
# your server should not require touching a theme, and installing a theme
# should not rename your server.
#
# Everything here is public -- it is handed to the browser -- so no secret
# belongs in this section.
#
# Note this is not APP_NAME above. That stays Laravel's internal application
# name, used for things like the mail "from" name. This is the brand players
# see, and no Vue component hardcodes it.
#
###############################################################################

GAME_NAME="Ragnarok Online"
GAME_SHORT_NAME="RO"
GAME_DESCRIPTION="Fantasy MMORPG"
# GAME_VERSION=

# Optional. With no logo the active theme draws its own mark from the short
# name, so the panel never shows a broken image. A URL rather than a path, so
# it can point at published theme assets, your own public/ directory, or a CDN.
# Run `php artisan theme:publish` to expose a theme's assets under /themes/.
# GAME_LOGO=/themes/fantasy/assets/images/logo.png
# GAME_FAVICON=/themes/fantasy/assets/images/favicon.png

# Navigation renders only the links that are set, so an unset one is an absent
# item rather than a dead link.
# GAME_WEBSITE_URL=
# GAME_DOWNLOADS_URL=
# GAME_DISCORD_URL=
# GAME_FORUM_URL=

# An operator-authored notice above the masthead. Off by default: a bar with
# nothing to announce is a placeholder. The dismissal id is derived from the
# message, so editing it brings the bar back for everyone who dismissed the old
# one. Tone is 'info', 'event' or 'maintenance'.
GAME_ANNOUNCEMENT_ENABLED=false
# GAME_ANNOUNCEMENT_MESSAGE="Season 5 is now live"
# GAME_ANNOUNCEMENT_URL=
# GAME_ANNOUNCEMENT_LABEL="Read more"
# GAME_ANNOUNCEMENT_TONE=event
# GAME_ANNOUNCEMENT_DISMISSIBLE=true

# The feature list on the front page lives in config/game.php rather than here,
# because each entry is a title, a description and an optional link. The
# shipped defaults only describe things this panel provides; replace them.

###############################################################################
# Theme
###############################################################################
#
# Which skin the panel wears. Resolved per request, so switching takes effect
# on the next page load.
#
# Two themes ship: `fantasy` (dark, warm, the default) and `slate` (cool,
# light-first, palette only). `php artisan theme:list` shows what is installed.
#
# Switching between installed themes needs only this value. Adding a NEW theme
# directory needs `npm run build`, because Vite has to have seen the files.
#
# See docs/THEMING.md.
#
###############################################################################

APP_THEME=fantasy

# Used when APP_THEME is not installed. The fallback is logged as a warning
# rather than applied silently, so a typo is visible. Leave unset to make a
# missing theme a hard error instead.
APP_THEME_FALLBACK=fantasy

# Fail outright rather than fall back. Worth enabling in CI so a deployment
# cannot quietly ship the wrong skin.
# APP_THEME_STRICT=false

# Where themes live, relative to the project root.
# APP_THEME_PATH=resources/themes

###############################################################################
# Logging
###############################################################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Application database
###############################################################################
#
# The panel's own tables: sessions, cache, the queue, and the hashed
# credentials it keeps for each account. This is NOT your rAthena database.
#
# Keep it separate. rAthena knows nothing about these tables, and giving the
# panel its own database means a mistake here cannot touch game data.
#
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=panel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=2880
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

###############################################################################
# rAthena database
###############################################################################
#
# Your existing Ragnarok database. The panel reads and writes game data here
# and creates its own cp_* tables alongside, which is where FluxCP put them.
#
# Nothing in this project drops or recreates an rAthena table. Run
# `php artisan panel:install-schema` once to create the cp_* tables; it skips
# anything already present and never alters it.
#
# Grant the panel's database user only what it needs. It does not need DROP.
#
###############################################################################

RATHENA_SERVER_NAME="rAthena"

RATHENA_DB_HOST=127.0.0.1
RATHENA_DB_PORT=3306
RATHENA_DB_DATABASE=ragnarok
RATHENA_DB_USERNAME=ragnarok
RATHENA_DB_PASSWORD=

# The character database, if it is not the same one as above.
# RATHENA_CHARMAP_DB_DATABASE=ragnarok

# The game log database. Commonly on another host, which is why rAthena and
# FluxCP both configure it separately.
RATHENA_LOGS_DB_DATABASE=ragnarok
# RATHENA_LOGS_DB_HOST=127.0.0.1
# RATHENA_LOGS_DB_USERNAME=
# RATHENA_LOGS_DB_PASSWORD=

# rAthena's own web database.
# RATHENA_WEB_DB_DATABASE=ragnarok

###############################################################################
# rAthena servers
###############################################################################
#
# Addresses are used to check whether each process is accepting connections.
#
# RATHENA_LOGIN_USE_MD5 and RATHENA_LOGIN_CASE_SENSITIVE must match your
# emulator's configuration. Getting them wrong does not produce an error, it
# produces accounts that cannot sign in.
#
# A warning about both: rAthena stores login.user_pass as cleartext, or as
# unsalted MD5 when UseMD5 is on, and its login server reads that column
# directly, so the panel can neither re-hash nor widen it. The panel keeps its
# own properly hashed credential and verifies against that instead, but the
# emulator's column stays as rAthena needs it. See docs/MIGRATION_DECISIONS.md
# (D1) for the full reasoning.
#
###############################################################################

RATHENA_LOGIN_ADDRESS=127.0.0.1
RATHENA_LOGIN_PORT=6900
RATHENA_LOGIN_USE_MD5=false
RATHENA_LOGIN_CASE_SENSITIVE=false

# rAthena group_id given to newly registered accounts.
RATHENA_LOGIN_DEFAULT_GROUP_ID=0

RATHENA_CHARMAP_NAME="rAthena"
RATHENA_CHAR_ADDRESS=127.0.0.1
RATHENA_CHAR_PORT=6121
RATHENA_MAP_ADDRESS=127.0.0.1
RATHENA_MAP_PORT=5121

RATHENA_RENEWAL=true
RATHENA_MAX_CHAR_SLOTS=9

# Timezone the game server's clock runs in, if it differs from the web host's.
# Affects the War of Emperium schedule.
# RATHENA_CHARMAP_TIMEZONE=Europe/London

# Rates shown on the server information page. rAthena keeps these in conf files
# the panel cannot read, so they are declared here.
RATHENA_RATE_BASE_EXP=100
RATHENA_RATE_JOB_EXP=100
RATHENA_RATE_MVP_EXP=100
RATHENA_RATE_COMMON_DROP=100

###############################################################################
# Panel policy
###############################################################################

PANEL_REGISTRATION_ENABLED=true

PANEL_USERNAME_MIN=4
PANEL_USERNAME_MAX=23
PANEL_PASSWORD_MIN=8
# Keep at or below 31. rAthena's password column is varchar(32), so with
# cleartext storage anything longer is truncated and can never be matched.
PANEL_PASSWORD_MAX=31
PANEL_PASSWORD_MIN_UPPER=1
PANEL_PASSWORD_MIN_LOWER=1
PANEL_PASSWORD_MIN_NUMBER=1
PANEL_PASSWORD_MIN_SYMBOL=0
# Allow the account name to appear inside the password. Off, as in FluxCP.
PANEL_PASSWORD_ALLOW_USERNAME=false

# A stricter policy for staff, applied at or above this panel level. Any value
# left out falls back to the player setting above. The legacy panel had this
# inverted and applied the strict rules to players -- see D17.
PANEL_STAFF_PASSWORD_LEVEL=1
PANEL_STAFF_PASSWORD_MIN=12
PANEL_STAFF_PASSWORD_MIN_UPPER=1
PANEL_STAFF_PASSWORD_MIN_LOWER=1
PANEL_STAFF_PASSWORD_MIN_NUMBER=1
PANEL_STAFF_PASSWORD_MIN_SYMBOL=1

PANEL_ALLOW_DUPLICATE_EMAILS=false
PANEL_REQUIRE_EMAIL_CONFIRMATION=false
PANEL_EMAIL_CONFIRM_EXPIRE_HOURS=48
PANEL_MINIMUM_AGE=13

# Password reset by e-mail. The link lets somebody choose their own password;
# no password is ever e-mailed (D16).
PANEL_PASSWORD_RESET_ENABLED=true
# Reset links expire. The legacy flow wrote cp_resetpass.request_date and never
# read it, so a link from an old mailbox worked indefinitely.
PANEL_PASSWORD_RESET_EXPIRE_HOURS=2
# Accounts at or above this panel level cannot be reset by e-mail, so holding a
# game master's mailbox is not enough to take their account. FluxCP's
# NoResetPassGroupLevel. Leave unset to allow every account.
PANEL_PASSWORD_RESET_BLOCK_LEVEL=1

# Require a new e-mail address to be confirmed before it replaces the old one.
# The address is what password reset trusts, so this is on by default.
PANEL_REQUIRE_EMAIL_CHANGE_CONFIRMATION=true
PANEL_EMAIL_CHANGE_EXPIRE_HOURS=24

# Character maintenance. Every one of these refuses while the character is
# online, which is not configurable -- rAthena writes the character back on
# logout and would silently revert the change.
PANEL_DIVORCE_KEEPS_CHILD=false
PANEL_DIVORCE_KEEPS_RINGS=false
PANEL_MAP_STATS_LIMIT=50

# Let a banned player reach the panel without lifting the ban in game, so they
# can read the reason or open a ticket. All off by default, as in FluxCP.
PANEL_ALLOW_IP_BANNED_LOGIN=false
PANEL_ALLOW_TEMP_BANNED_LOGIN=false
PANEL_ALLOW_PERM_BANNED_LOGIN=false

# Sign-in throttling, which the legacy panel had none of.
PANEL_LOGIN_MAX_ATTEMPTS=5
PANEL_LOGIN_MAX_ATTEMPTS_PER_ADDRESS=30
PANEL_LOGIN_DECAY_SECONDS=60

PANEL_CAPTCHA_ON_REGISTRATION=false
PANEL_CAPTCHA_ON_LOGIN=false
# 'native' draws the challenge here and needs the GD extension. 'recaptcha'
# delegates to Google, and the client cannot render its widget on its own --
# you have to add the script yourself. See D19.
PANEL_CAPTCHA_DRIVER=native
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
PANEL_CAPTCHA_LENGTH=5
# 0/O and 1/I/L are left out: a challenge nobody can read stops registrations
# rather than robots.
PANEL_CAPTCHA_CHARACTERS=ABCDEFGHJKMNPQRSTUVWXYZ23456789
PANEL_CAPTCHA_WIDTH=200
PANEL_CAPTCHA_HEIGHT=70
PANEL_CAPTCHA_EXPIRE_SECONDS=600

# Send the account e-mails through the queue.
#
# Off by default, which is the opposite of the usual advice and deliberate: a
# queued message on a server with no `php artisan queue:work` running is a
# message that is never sent, and the people affected are the ones who cannot
# finish registering or get back into their account -- so they cannot report it
# either. Turn this on once a worker is running.
PANEL_QUEUE_MAIL=false

# How long to wait for each server to answer, and how long to trust the answer.
PANEL_SERVER_STATUS_TIMEOUT=2
PANEL_SERVER_STATUS_CACHE_SECONDS=30
# Needs something recording into cp_onlinepeak, so off by default.
PANEL_SERVER_STATUS_SHOW_PEAK=false

PANEL_RANKING_LIMIT=100
PANEL_RANKING_HIDE_PERM_BANNED=true
PANEL_RANKING_HIDE_TEMP_BANNED=false
# Hide characters of accounts at or above this panel level, so staff do not
# head a player ladder. 1 is the junior game master tier.
PANEL_RANKING_HIDE_AT_LEVEL=1
PANEL_RANKING_INACTIVE_DAYS=0

PANEL_PER_PAGE=20
PANEL_MAX_PER_PAGE=100

# Aggregate counts for the statistics block are full-table counts behind a
# landing page, so they are cached.
PANEL_STATISTICS_CACHE_SECONDS=300

###############################################################################
# Realtime (Laravel Reverb)
###############################################################################
#
# Optional. Without it the client falls back to polling and the panel still
# works; status just updates less promptly.
#
# Generate your own credentials -- do not ship these values. Only the app key
# reaches the browser; the secret stays on the server.
#
###############################################################################

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

###############################################################################
# Scheduled maintenance
###############################################################################
#
# The legacy panel did both of these inline, from a hook that ran before every
# request, so they happened only as often as somebody loaded a page.

# Delete registrations whose confirmation window has passed. Run by
# `panel:prune-unconfirmed`, scheduled daily. The command refuses to delete
# anything unless this is true, and has --dry-run to show what it would remove.
PANEL_PRUNE_UNCONFIRMED=false

# Release item-shop credits held against an unconfirmed donation.
PANEL_RELEASE_HELD_CREDITS=false

###############################################################################
# Mail
###############################################################################
#
# MAIL_MAILER=log writes messages to the log instead of sending them, which is
# right for development and wrong for production: without a real mailer, nobody
# can confirm a registration or reset a password.
#
# MAIL_FROM_ADDRESS should be a mailbox on a domain whose SPF and DKIM records
# allow this server to send, or the account e-mails will be filed as spam.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Frontend
###############################################################################

VITE_APP_NAME="${APP_NAME}"
