{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint . && vue-tsc --noEmit",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"resources/**/*.{ts,vue,css}\"",
        "format:check": "prettier --check \"resources/**/*.{ts,vue,css}\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.4",
        "@vitejs/plugin-vue": "^6.0.9",
        "concurrently": "^10.0.3",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.0.0",
        "vue": "^3.5.43",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "laravel-echo": "^2.5.0",
        "pinia": "^4.0.3",
        "pusher-js": "^8.6.0",
        "vue-router": "^5.3.1"
    }
}
