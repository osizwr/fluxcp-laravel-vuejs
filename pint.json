{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "strict_comparison": true,
        "strict_param": true,
        "final_class": false,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "void_return": true
    },
    "exclude": [
        "legacy",
        "bootstrap/cache",
        "storage"
    ]
}
